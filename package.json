{
  "name": "tolva",
  "version": "0.0.0",
  "private": true,
  "description": "TÖLVA: learn Icelandic from the oracle in the machine. A static, grammar-first course website.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs 8080",
    "test": "node --test tests/",
    "check": "node scripts/check-contrast.mjs && node scripts/check-i18n.mjs && node scripts/validate-content.mjs && node scripts/build-tags.mjs --check && node scripts/build-sw.mjs --check && node --test tests/",
    "qa": "node scripts/visual-qa.mjs",
    "probe": "node scripts/probe-apis.mjs",
    "probe:coverage": "node scripts/probe-apis.mjs --coverage",
    "build:data": "node scripts/build-data.mjs",
    "build:audio": "node -e \"process.exit(require('child_process').spawnSync(process.platform === 'win32' ? '.venv/Scripts/python' : '.venv/bin/python', ['-I', 'scripts/build-audio.py', ...process.argv.slice(1)], { stdio: 'inherit' }).status)\" --",
    "validate": "node scripts/validate-content.mjs",
    "build:tala": "node scripts/build-tala.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:tags": "node scripts/build-tags.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "smoke": "node tests/smoke.mjs --all"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
