{
  "name": "tolva",
  "version": "0.0.0",
  "private": true,
  "description": "TÖLVA: learn Icelandic from the oracle in the machine. A static, grammar-first course website.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs 8080",
    "test": "node --test tests/",
    "check": "node scripts/check-contrast.mjs && node scripts/check-i18n.mjs && node scripts/validate-content.mjs && node --test tests/",
    "qa": "node scripts/visual-qa.mjs",
    "probe": "node scripts/probe-apis.mjs",
    "probe:coverage": "node scripts/probe-apis.mjs --coverage",
    "build:data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate-content.mjs",
    "build:demo": "node scripts/build-demo-data.mjs",
    "build:tala": "node scripts/build-tala.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
