{
 "sentences": [
  {
   "id": "451938",
   "is": "Hvað heitir þú?",
   "en": "What is your name?",
   "author": "Swift"
  },
  {
   "id": "4171415",
   "is": "Vilt þú te eða kaffi?",
   "en": "Do you want tea or coffee?",
   "author": "lifind"
  },
  {
   "id": "707638",
   "is": "Þú drekkur te.",
   "en": "You drink tea.",
   "author": "Swift"
  },
  {
   "id": "3838979",
   "is": "Góðan daginn!",
   "en": "Good morning!",
   "author": "arnarsmata"
  },
  {
   "id": "669468",
   "is": "Ég á tvær dætur.",
   "en": "I have two daughters.",
   "author": "Swift"
  },
  {
   "id": "788039",
   "is": "Barnið er að drekka mjólk.",
   "en": "The child is drinking some milk.",
   "author": "Pharamp"
  }
